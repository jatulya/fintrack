# Backend environment variables
# Copy to .env and fill in values from your Supabase project dashboard
PORT=your-port
NODE_ENV=your-node-environment

# Supabase (Settings → API)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend origin (for CORS)
CORS_ORIGIN=your-frontend-origin

# API base path (no trailing slash)
API_BASE_PATH=your-api-base-path

# Cookie name for httpOnly Supabase refresh token (letters, digits, _ - only; no @ or spaces)
REFRESH_TOKEN_COOKIE_NAME=your-refresh-token-cookie-name
